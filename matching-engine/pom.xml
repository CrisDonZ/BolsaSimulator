<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>co.bolsasim</groupId>
        <artifactId>bolsasim</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>matching-engine</artifactId>
    <name>matching-engine</name>
    <description>Motor de emparejamiento: lee las órdenes de Kafka y las cruza</description>

    <dependencies>
        <dependency>
            <groupId>co.bolsasim</groupId>
            <artifactId>eventos</artifactId>
        </dependency>

        <!-- Consumidor de Kafka (@KafkaListener). Este servicio no tiene API web. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- Jackson para convertir el JSON de Kafka en ComandoOrden.
             order-service lo recibe con el starter web; este servicio no lo tiene, así que va explícito. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
